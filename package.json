{
  "name": "@summersec/dsh-web-auth",
  "version": "0.1.2",
  "description": "Transport-level authentication gate for the DeepSeek Harness Web GUI",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./auth": "./src/auth.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "bin",
    "docs/assets/dsh-web-auth-login-v0.1.2.png",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "bin": {
    "dsh-web-auth": "bin/dsh-web-auth.js"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check src/auth.js && node --check src/index.js && node --check bin/dsh-web-auth.js && node --test",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "authentication",
    "web"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SummerSec/dsh-web-auth.git"
  },
  "bugs": {
    "url": "https://github.com/SummerSec/dsh-web-auth/issues"
  },
  "homepage": "https://github.com/SummerSec/dsh-web-auth#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
